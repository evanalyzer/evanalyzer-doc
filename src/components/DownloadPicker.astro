---
const REPO = "evanalyzer/evanalyzer";
---

<div class="download-picker not-content" data-repo={REPO}>
  <div class="picker-step">
    <p class="picker-label">1. Choose your operating system</p>
    <div class="picker-options" role="group" aria-label="Operating system">
      <button type="button" class="picker-btn" data-os="windows">
        <span class="picker-btn-title">Windows</span>
      </button>
      <button type="button" class="picker-btn" data-os="linux">
        <span class="picker-btn-title">Linux</span>
      </button>
      <button type="button" class="picker-btn" data-os="macos">
        <span class="picker-btn-title">macOS</span>
      </button>
    </div>
  </div>

  <div class="picker-step">
    <p class="picker-label">2. Choose your processor</p>
    <div class="picker-options" role="group" aria-label="Processor">
      <button type="button" class="picker-btn" data-arch="x86_64">
        <span class="picker-btn-title">x86-64</span>
        <span class="picker-btn-sub">Intel / AMD - most PCs</span>
      </button>
      <button type="button" class="picker-btn" data-arch="arm64">
        <span class="picker-btn-title">ARM64</span>
        <span class="picker-btn-sub">Snapdragon, Apple Silicon, ARM servers</span>
      </button>
    </div>
    <p class="picker-note" data-arch-note hidden>
      macOS builds are for Apple Silicon (ARM64) only.
    </p>
  </div>

  <div class="picker-step">
    <p class="picker-label">3. CUDA acceleration?</p>
    <div class="picker-options" role="group" aria-label="CUDA acceleration">
      <button type="button" class="picker-btn" data-cuda="false">
        <span class="picker-btn-title">No CUDA</span>
        <span class="picker-btn-sub">CPU only - works everywhere</span>
      </button>
      <button type="button" class="picker-btn" data-cuda="true">
        <span class="picker-btn-title">With CUDA</span>
        <span class="picker-btn-sub">NVIDIA GPU required</span>
      </button>
    </div>
    <p class="picker-note" data-cuda-note hidden>
      CUDA builds exist only for x86-64 - showing the CPU build instead.
    </p>
  </div>

  <div class="picker-result" data-result>
    <p class="picker-placeholder">Pick an operating system above to see the matching download.</p>
  </div>
</div>

<script define:vars={{ REPO }}>
  // Module scripts never set `document.currentScript`, and only one picker is
  // ever rendered per page, so a plain class lookup is the reliable option.
  const root = document.querySelector(".download-picker");
  const osButtons = root.querySelectorAll("[data-os]");
  const archButtons = root.querySelectorAll("[data-arch]");
  const archNote = root.querySelector("[data-arch-note]");
  const cudaButtons = root.querySelectorAll("[data-cuda]");
  const cudaNote = root.querySelector("[data-cuda-note]");
  const resultEl = root.querySelector("[data-result]");

  // archChoice is what the user picked; arch is what is shown (macOS forces ARM64).
  let state = { os: null, arch: "x86_64", archChoice: "x86_64", cuda: false };
  let releasePromise = null;

  function osKeywords(os) {
    return { windows: ["windows"], linux: ["linux"], macos: ["macos", "darwin"] }[os] || [];
  }

  function archKeywords(arch) {
    return { x86_64: ["x86_64", "x64", "amd64"], arm64: ["arm64", "aarch64"] }[arch] || [];
  }

  function assetMatches(name, os, arch, cuda) {
    const n = name.toLowerCase();
    if (!n.startsWith("evanalyzer-")) return false;
    if (!osKeywords(os).some((k) => n.includes(k))) return false;
    if (!archKeywords(arch).some((k) => n.includes(k))) return false;
    const hasCuda = n.includes("cuda");
    return cuda ? hasCuda : !hasCuda;
  }

  function formatSize(bytes) {
    const mb = bytes / (1024 * 1024);
    if (mb > 1024) return `${(mb / 1024).toFixed(2)} GB`;
    return `${mb.toFixed(0)} MB`;
  }

  // Only the newest published release counts - pre-releases and drafts are skipped,
  // and an older release is never offered as a fallback.
  async function fetchLatestRelease() {
    if (!releasePromise) {
      releasePromise = fetch(`https://api.github.com/repos/${REPO}/releases?per_page=30`)
        .then((res) => {
          if (!res.ok) throw new Error(`GitHub API returned ${res.status}`);
          return res.json();
        })
        .then((releases) => releases.find((r) => r.tag_name !== "app-deps" && !r.draft && !r.prerelease) || null);
    }
    return releasePromise;
  }

  function releasesUrl() {
    return `https://github.com/${REPO}/releases/latest`;
  }

  function renderLoading() {
    resultEl.innerHTML = `<p class="picker-placeholder">Looking up the latest build…</p>`;
  }

  function renderError(message) {
    resultEl.innerHTML = `
      <p class="picker-error">${message}</p>
      <p><a href="${releasesUrl()}">Browse all releases on GitHub →</a></p>
    `;
  }

  function renderNoSelection() {
    resultEl.innerHTML = `<p class="picker-placeholder">Pick an operating system above to see the matching download.</p>`;
  }

  function renderNoMatch() {
    resultEl.innerHTML = `
      <p class="picker-error">No build for this combination has been published yet.</p>
      <p><a href="${releasesUrl()}">Check the releases page →</a> - a build may be uploading.</p>
    `;
  }

  function renderMatch(release, assets) {
    const sorted = [...assets].sort((a, b) => a.name.localeCompare(b.name));
    const links = sorted
      .map(
        (a) => `
        <a class="picker-download" href="${a.browser_download_url}">
          <span class="picker-download-name">${a.name}</span>
          <span class="picker-download-size">${formatSize(a.size)}</span>
        </a>`
      )
      .join("");

    const multiPart =
      sorted.length > 1
        ? `<p class="picker-note">This build is split into ${sorted.length} parts. Download all of them into the same folder, then extract the first part (e.g. with <code>7z x ${sorted[0].name}</code>) - the rest are pulled in automatically.</p>`
        : "";

    resultEl.innerHTML = `
      <p class="picker-version">Latest matching release: <strong>${release.tag_name}</strong></p>
      <div class="picker-downloads">${links}</div>
      ${multiPart}
    `;
  }

  async function update() {
    if (!state.os) {
      renderNoSelection();
      return;
    }
    renderLoading();
    try {
      const release = await fetchLatestRelease();
      const assets = release
        ? (release.assets || []).filter((a) => assetMatches(a.name, state.os, state.arch, state.cuda))
        : [];
      if (assets.length > 0) {
        renderMatch(release, assets);
        return;
      }
      renderNoMatch();
    } catch (err) {
      renderError(`Couldn't reach the GitHub API (${err.message}).`);
    }
  }

  function select(buttons, isSelected) {
    buttons.forEach((b) => b.classList.toggle("is-selected", isSelected(b)));
  }

  // macOS has only ARM64 builds, and CUDA builds exist only for x86-64:
  // disable what doesn't exist and fall back to what does.
  function applyConstraints() {
    const isMac = state.os === "macos";
    archButtons.forEach((b) => (b.disabled = isMac && b.dataset.arch === "x86_64"));
    archNote.hidden = !isMac;
    state.arch = isMac ? "arm64" : state.archChoice;
    select(archButtons, (b) => b.dataset.arch === state.arch);

    const noCuda = state.arch === "arm64";
    cudaButtons.forEach((b) => (b.disabled = noCuda && b.dataset.cuda === "true"));
    cudaNote.hidden = !(noCuda && state.cuda);
    if (noCuda) state.cuda = false;
    select(cudaButtons, (b) => (b.dataset.cuda === "true") === state.cuda);
  }

  osButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      state.os = btn.dataset.os;
      select(osButtons, (b) => b === btn);
      applyConstraints();
      update();
    });
  });

  archButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.disabled) return;
      state.archChoice = btn.dataset.arch;
      applyConstraints();
      update();
    });
  });

  cudaButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.disabled) return;
      state.cuda = btn.dataset.cuda === "true";
      applyConstraints();
      update();
    });
  });

  // Default selection: no CUDA, OS and architecture guessed from the browser
  // (user can override). Browsers rarely tell ARM apart, so x86-64 is the default
  // except on macOS, which only has Apple Silicon builds.
  const ua = navigator.userAgent.toLowerCase();
  if (/aarch64|arm64|armv8/.test(ua)) state.archChoice = "arm64";
  applyConstraints();
  const guessedOs = ua.includes("windows") ? "windows" : ua.includes("mac") ? "macos" : ua.includes("linux") ? "linux" : null;
  if (guessedOs) {
    const btn = root.querySelector(`[data-os="${guessedOs}"]`);
    if (btn) btn.click();
  }
</script>

<style>
  .download-picker {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .picker-label {
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .picker-options {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .picker-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--ink-radius-lg);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    min-width: 9rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .picker-btn:hover:not(:disabled) {
    background: var(--ink-hover);
  }

  .picker-btn.is-selected {
    border-color: var(--ink-focus);
    background: var(--ink-selection);
    box-shadow: 0 0 0 3px var(--ink-focus-ring);
  }

  .picker-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .picker-btn-title {
    font-weight: 600;
  }

  .picker-btn-sub {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .picker-note {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }

  .picker-result {
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--ink-radius-lg);
    background: var(--ink-panel);
  }

  .picker-placeholder {
    color: var(--sl-color-gray-3);
    margin: 0;
  }

  .picker-error {
    color: var(--sl-color-orange);
    margin: 0 0 0.5rem 0;
  }

  .picker-version {
    margin: 0 0 0.75rem 0;
  }

  .picker-downloads {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .picker-download {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    border-radius: var(--ink-radius-md);
    background: var(--ink-primary);
    color: var(--ink-on-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .picker-download:hover {
    background: var(--ink-primary-hover);
  }

  .picker-download-size {
    font-weight: 400;
    opacity: 0.85;
    font-size: 0.85rem;
    margin-left: 1rem;
    white-space: nowrap;
  }
</style>
