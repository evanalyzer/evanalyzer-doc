---
// Override of @astrojs/starlight/components/SiteTitle.astro.
// Same link/title structure as the default, but swaps the accent-coloured
// text for plain bold black (old site: `header .headercontent .imagechome`).
// NOTE: no logo image yet - see TODO note to the user about supplying one.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<span translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: var(--sl-nav-gap);
		font-size: var(--sl-text-h4);
		font-weight: 700;
		font-family: var(--sl-font);
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
</style>
