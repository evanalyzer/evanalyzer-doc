---
// Override of @astrojs/starlight/components/SiteTitle.astro.
// The app's icon (icon-orange.svg from the evanalyzer repo) and the name
// in plain bold text, like the EVA button and the Start page's heading.
import logo from '../../assets/logo.svg';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<img src={logo.src} width="28" height="28" alt="" />
	<span translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.55rem;
		font-size: var(--sl-text-h4);
		font-weight: 700;
		letter-spacing: -0.02em;
		font-family: var(--sl-font);
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	img {
		width: 1.75rem;
		height: 1.75rem;
		flex-shrink: 0;
	}
</style>
