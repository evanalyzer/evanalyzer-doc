---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  beforeSrc: ImageMetadata;
  afterSrc: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel: string;
  afterLabel: string;
}

const { beforeSrc, afterSrc, beforeAlt, afterAlt, beforeLabel, afterLabel } = Astro.props;
---

<div class="evx-cs not-content" style={`--cs-pos: 50%; aspect-ratio: ${beforeSrc.width} / ${beforeSrc.height};`}>
  <Image class="evx-cs-img evx-cs-after" src={afterSrc} alt={afterAlt} loading="lazy" decoding="async" />
  <Image class="evx-cs-img evx-cs-before" src={beforeSrc} alt={beforeAlt} loading="lazy" decoding="async" />
  <span class="evx-cs-label evx-cs-label-before">{beforeLabel}</span>
  <span class="evx-cs-label evx-cs-label-after">{afterLabel}</span>
  <div class="evx-cs-line" aria-hidden="true"><span class="evx-cs-grip">⇔</span></div>
  <input
    class="evx-cs-range"
    type="range"
    min="0"
    max="100"
    value="50"
    step="1"
    aria-label={`Drag to compare ${beforeLabel} and ${afterLabel}`}
  />
</div>

<style>
  .evx-cs {
    position: relative;
    width: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--sl-shadow-lg);
    background: var(--sl-color-bg-nav);
    touch-action: pan-y;
  }
  .evx-cs-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
  }
  .evx-cs-before {
    clip-path: inset(0 calc(100% - var(--cs-pos)) 0 0);
  }
  .evx-cs-label {
    position: absolute;
    top: 0.75rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .evx-cs-label-before {
    left: 0.75rem;
  }
  .evx-cs-label-after {
    right: 0.75rem;
  }
  .evx-cs-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--cs-pos);
    transform: translateX(-50%);
    width: 2px;
    background: #fff;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .evx-cs-grip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 1rem;
    box-shadow: var(--sl-shadow-sm);
  }
  .evx-cs-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    -webkit-appearance: none;
  }
  .evx-cs-range:focus-visible ~ .evx-cs-line .evx-cs-grip {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".evx-cs").forEach((compare) => {
    const range = compare.querySelector<HTMLInputElement>(".evx-cs-range");
    range?.addEventListener("input", () => {
      compare.style.setProperty("--cs-pos", range.value + "%");
    });
  });
</script>
