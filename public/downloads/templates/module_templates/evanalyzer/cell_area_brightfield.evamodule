      "default": "px",
      "bindings": [
        {
          "step": 11,
          "param": "size_unit"
        }
      ]
    },
    {
      "key": "thresholds_1_min_threshold",
      "label": "Thresholds 1 · Min Threshold",
      "description": "",
      "default": 0,
      "bindings": [
        {
          "step": 8,
