  "pipelines": [
    {
      "id": 1,
      "name": "nuclei",
      "description": "IdentifyPrimaryObjects Nuclei on CorrDNA",
      "imageSource": {
        "channel": 0
      },
      "enabled": true,
      "steps": [
        {
          "id": 1,
          "enabled": true,
          "command": {
            "type": "IMAGE_MATH",
            "operand": "MULTIPLY",
            "secondImageAddress": {
              "channel": 2
            },
            "swapOperands": false
          }
        },
        {
          "id": 2,
          "enabled": true,
          "command": {
            "type": "IMAGE_CACHE",
            "mode": "STORE",
            "address": {
              "memory": {
                "pipelineContext": 1
              }
            }
          }
        },
        {
          "id": 3,
          "enabled": true,
          "command": {
            "type": "GAUSSIAN_BLUR",
            "kernelSize": 7,
            "sigma": 1.0
          }
        },
        {
          "id": 4,
          "enabled": true,
          "command": {
            "type": "THRESHOLD",
            "thresholds": [
              {
                "method": {
                  "type": "LI"
                },
                "minThreshold": 0.0,
                "maxThreshold": 65535.0,
                "unit": "BIT",
                "segmentationClass": 1,
                "valueSource": {
                  "MEMORY": {
                    "pipelineContext": 1
                  }
                }
              }
            ]
          }
        },
        {
          "id": 5,
          "enabled": true,
          "command": {
            "type": "FILL_HOLES"
          }
        },
        {
          "id": 6,
          "enabled": true,
          "command": {
            "type": "CONNECTED_COMPONENTS",
            "minSize": 1
          }
        },
        {
          "id": 7,
          "enabled": true,
          "command": {
            "type": "WATERSHED",
            "maximumFinderTolerance": 3.33,
            "smoothingSigma": 1.02,
            "minObjectSize": 0,
            "seedSource": "INTENSITY"
          }
        },
        {
          "id": 8,
          "enabled": true,
          "command": {
            "type": "FILL_OBJECT_HOLES"
          }
        },
        {
          "id": 9,
          "enabled": true,
          "command": {
            "type": "EXTRACT_OBJECTS",
            "maxObjectsBeforeFail": 100000,
            "classMapping": [
              {
                "segmentationClass": 1,
                "objectClass": {
                  "GLOBAL": 1
                }
              }
            ]
          }
        },
        {
          "id": 10,
          "enabled": true,
          "command": {
            "type": "CLASSIFY_OBJECTS",
            "originSegmentation": [],
            "inputClasses": [
              {
                "GLOBAL": 1
              }
            ],
            "matchHandling": "REMOVE_ALL_CLASSES_IF_NOT_MATCH",
            "outputClass": "UNSET",
            "overlappingWith": "UNSET",
            "minIntersectionSize": 0.0,
            "sizeUnit": "PIXELS",
            "minSize": 19.6,
            "maxSize": 706.9,
            "minCircularity": 0.0,
            "maxCircularity": 1.0,
            "minSolidity": 0.0,
            "maxSolidity": 1.0,
            "minAspectRatio": 0.0,
            "maxAspectRatio": 2147483600.0,
            "minEccentricity": 0.0,
            "maxEccentricity": 1.0,
            "minFeret": 0.0,
            "maxFeret": 2147483600.0,
            "allowEdgeTouching": false,
            "intensityFilters": []
          }
        }
      ]
    },
    {
      "id": 2,
      "name": "protein foreground",
      "description": "Threshold of CorrProtein used by IdentifySecondaryObjects",
      "imageSource": {
        "channel": 1
      },
      "enabled": true,
      "steps": [
        {
          "id": 1,
          "enabled": true,
          "command": {
            "type": "IMAGE_MATH",
            "operand": "MULTIPLY",
            "secondImageAddress": {
              "channel": 3
            },
            "swapOperands": false
          }
        },
        {
          "id": 2,
          "enabled": true,
          "command": {
            "type": "THRESHOLD",
            "thresholds": [
              {
                "method": {
                  "type": "LI"
                },
                "minThreshold": 0.0,
                "maxThreshold": 65535.0,
                "unit": "BIT",
                "segmentationClass": 2,
                "valueSource": "ACTUAL_IMAGE"
              }
            ]
          }
        },
        {
          "id": 3,
          "enabled": true,
          "command": {
            "type": "CONNECTED_COMPONENTS",
            "minSize": 1
          }
        },
        {
          "id": 4,
          "enabled": true,
          "command": {
            "type": "EXTRACT_OBJECTS",
            "maxObjectsBeforeFail": 100000,
            "classMapping": [
              {
                "segmentationClass": 2,
                "objectClass": {
                  "GLOBAL": 2
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "name": "cells and cytoplasm",
      "description": "IdentifySecondaryObjects (Distance-B) + IdentifyTertiaryObjects",
      "imageSource": "SCRATCHPAD",
      "enabled": true,
      "steps": [
        {
          "id": 1,
