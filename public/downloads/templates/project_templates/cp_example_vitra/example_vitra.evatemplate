        "notes": "Nuclei dilated by 8 px (Distance-B reach), helper"
      },
      {
        "id": 4,
        "color": "#888888",
        "name": "cells@reach",
        "notes": "nuclei@expanded AND protein@foreground, helper"
      },
      {
        "id": 5,
        "color": "#aaaaaa",
        "name": "cells@mask",
        "notes": "nuclei OR cells@reach: pixels a cell may occupy, helper"
      },
      {
        "id": 6,
        "color": "#33cc66",
        "name": "cells",
        "notes": "Cells (IdentifySecondaryObjects Distance-B, 8 px)"
      },
      {
        "id": 7,
        "color": "#555599",
        "name": "nuclei@shrunk",
        "notes": "Nuclei eroded by 1 px (IdentifyTertiaryObjects' shrink), helper"
