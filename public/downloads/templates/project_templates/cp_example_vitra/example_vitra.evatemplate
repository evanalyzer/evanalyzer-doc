            "minOverlapSize": 1.0,
            "outputClass": {
              "GLOBAL": 4
            },
            "keepUnmatched": false
          }
        },
        {
          "id": 3,
          "enabled": true,
          "command": {
            "type": "OBJECT_MATH",
            "operation": "OR",
            "inputClass": {
              "GLOBAL": 1
            },
            "otherClass": {
              "GLOBAL": 4
            },
            "otherFilterClasses": [],
            "sizeUnit": "PIXELS",
