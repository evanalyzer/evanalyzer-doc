      "meta": {
        "name": "EV in cell detection",
        "shortDescription": "EV in cell detection",
        "description": "Detects extracellular vesicles inside cells using median background subtraction, blurring, Li thresholding and watershed splitting. The class the objects get is the module's \"EVs in cells\" parameter.",
        "authors": [
          {
            "fullName": "Melanie Schuerz",
            "organization": "University of Salzburg"
          }
        ],
        "creationTime": "2026-10-20T17:24:51.268492007Z",
