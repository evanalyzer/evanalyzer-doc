    {
      "key": "CELL_AREA_BRIGHTFIELD",
      "meta": {
        "name": "Cell area brightfield",
        "shortDescription": "Cell brightfield",
        "description": "Segments the overall cell area from a brightfield image using Sobel edge detection, blurring and an automatic threshold. The class the objects get is the module's \"Cell area\" parameter.",
        "authors": [
          {
            "fullName": "Melanie Schuerz",
            "organization": "University of Salzburg"
          }
