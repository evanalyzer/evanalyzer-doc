    {
      "key": "NUCLEI_DETECTION",
      "meta": {
        "name": "Nuclei detection",
        "shortDescription": "Nuclei detection",
        "description": "Detects cell nuclei using blurring, rolling ball background subtraction, Triangle thresholding and hole filling, like the EVAnalyzer Fiji plugin (touching nuclei are not split). The class the objects get is the module's \"Nuclei\" parameter.",
        "authors": [
          {
            "fullName": "Melanie Schuerz",
            "organization": "University of Salzburg"
          }
        ],
        "creationTime": "2026-10-20T17:25:28.754415732Z",
        "version": 3,
        "category": "nucleus",
        "tags": [
          "nucleus"
        ],
        "appVersion": "0.1.0"
      },
      "classes": [],
      "steps": [
        {
          "id": 1,
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "id": 2,
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "id": 3,
          "enabled": true,
          "command": {
            "type": "ROLLING_BALL",
            "radius": 4.0,
            "ballType": "PARABOLOID",
            "preSmooth": true
          }
        },
        {
          "id": 4,
          "enabled": true,
          "command": {
            "type": "THRESHOLD",
            "thresholds": [
              {
                "method": {
                  "type": "TRIANGLE"
                },
                "minThreshold": 0.0,
                "maxThreshold": 65535.0,
                "unit": "BIT",
                "segmentationClass": 2,
                "valueSource": "ACTUAL_IMAGE"
              }
            ]
          }
        },
        {
          "id": 5,
          "enabled": true,
          "command": {
            "type": "FILL_HOLES"
          }
        },
        {
          "id": 6,
          "enabled": true,
          "command": {
            "type": "CONNECTED_COMPONENTS",
            "minSize": 1
          }
        },
        {
          "id": 7,
          "enabled": true,
          "command": {
            "type": "EXTRACT_OBJECTS",
            "maxObjectsBeforeFail": 100000,
            "classMapping": [
              {
                "segmentationClass": 2,
                "objectClass": {
                  "GLOBAL": 2
                }
              }
            ]
          }
        },
        {
          "id": 8,
          "enabled": true,
          "command": {
            "type": "CLASSIFY_OBJECTS",
            "originSegmentation": [],
            "inputClasses": [
              {
                "GLOBAL": 2
              }
            ],
            "matchHandling": "REMOVE_ALL_CLASSES_IF_NOT_MATCH",
            "outputClass": "UNSET",
            "overlappingWith": "UNSET",
            "minIntersectionSize": 0.0,
            "sizeUnit": "PIXELS",
            "minSize": 1000.0,
            "maxSize": 2147483600.0,
            "minCircularity": 0.0,
            "maxCircularity": 1.0,
            "minSolidity": 0.0,
            "maxSolidity": 1.0,
            "minAspectRatio": 0.0,
            "maxAspectRatio": 2147483600.0,
            "minEccentricity": 0.0,
            "maxEccentricity": 1.0,
            "minFeret": 0.0,
            "maxFeret": 2147483600.0,
            "allowEdgeTouching": true,
            "intensityFilters": []
          }
        }
      ],
      "parameters": [
        {
          "key": "nuclei",
          "label": "Nuclei",
          "description": "",
          "section": "Classes",
          "default": "2",
          "bindings": [
            {
              "step": 7,
              "param": "class_mapping.0.object_class"
            },
            {
              "step": 8,
              "param": "input_classes"
            }
          ]
        },
        {
          "key": "threshold_method",
          "label": "Threshold method",
          "description": "",
          "section": "Detection",
          "default": "Triangle",
          "bindings": [
            {
              "step": 4,
              "param": "thresholds.0.method"
            }
          ]
        },
        {
          "key": "min_threshold",
          "label": "Min threshold",
          "description": "",
          "section": "Detection",
          "default": 0,
          "bindings": [
            {
              "step": 4,
              "param": "thresholds.0.min_threshold"
            }
          ]
        },
        {
          "key": "min_area",
          "label": "Min area",
          "description": "",
          "section": "Filter",
          "default": 1000,
          "bindings": [
            {
              "step": 8,
              "param": "min_size"
            }
          ]
        },
        {
          "key": "max_area",
          "label": "Max area",
          "description": "",
          "section": "Filter",
          "default": 2147483600,
          "bindings": [
            {
              "step": 8,
              "param": "max_size"
            }
          ]
        },
        {
          "key": "size_unit",
          "label": "Size unit",
          "description": "",
          "section": "Filter",
          "default": "px",
          "bindings": [
            {
              "step": 8,
              "param": "size_unit"
            }
          ]
        }
      ],
      "origin": {
        "originModuleKey": "NUCLEI_DETECTION",
        "library": "nuclei_detection.evacomp",
        "version": 2,
        "contentHash": "85b51ca28c990752"
      }
