        "fullName": "Melanie Schuerz",
        "organization": "University of Salzburg"
      }
    ],
    "creationTime": "2026-06-11T00:00:00Z",
    "category": "Spot Detection",
    "tags": [
      "spot-count",
      "particle-analysis"
    ]
  },
  "classification": {
    "classes": [
      {
        "id": {
          "VALID": 0
        },
        "color": "#97978f",
        "name": "Background",
        "notes": ""
