  "plate": {
    "groupingMode": "AUTO",
    "groupingRegex": "",
    "plateSize": "PLATE1X1",
    "wellLayout": {
      "FIXED": {
        "rows": 4,
        "cols": 4
      }
    },
    "wellImageOrder": [
      1,
