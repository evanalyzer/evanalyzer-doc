        "authors": [
          {
            "fullName": "Melanie Schuerz",
            "organization": "University of Salzburg"
          }
        ],
        "creationTime": "2026-10-20T17:25:55.830699113Z",
        "version": 2,
        "category": "cell",
        "tags": [
          "cell"
        ],
        "appVersion": "0.1.0"
      },
      "classes": [],
