    {
      "id": 4,
      "name": "Tetraspeck",
      "description": "This pipeline enables the removal of calibration beads (e.g. tetraspeck) that are fluorescent in all channels.\n1. Enable pipeline \ud83d\udc41\n2. Select Tetraspeck image channel (channel showing only tetraspecks)\n3. Adapt (manual) threshold\n4. The *Classify objects* steps at the end remove every spot overlapping a tetraspeck - add or remove steps for the channels where tetraspecks need to be removed.",
      "imageSource": {
        "channel": 3
      },
      "enabled": false,
      "steps": [
