    {
      "id": 7,
      "name": "Coloc",
      "description": "Colocalisation is set to 0.1 (0.1-1) as default and may be changed.\n\nWith these settings you will find the following groups:\n- @spots: contains spots outside the cells\n- @in-cell-spots: includes all spots that are within the cell(coloc and non-coloc spots)\n- @ in-cell-spot non coloc: spots only detected in the one respective channel\n- 2 channel coloc spots (e.g. ch1@in-cell-spots coloc ch2) includes all spots in cell that have channel 1 and 2 and also includes spots that might have ch3\n- 3 channel coloc spots: in-cell-spots recognized in ch1, 2 and 3",
      "imageSource": "SCRATCHPAD",
      "enabled": true,
      "steps": [
        {
          "enabled": true,
          "command": {
            "type": "COLOCALIZATION",
            "classesToColoc": [
              {
                "GLOBAL": 13
              },
              {
                "GLOBAL": 3
