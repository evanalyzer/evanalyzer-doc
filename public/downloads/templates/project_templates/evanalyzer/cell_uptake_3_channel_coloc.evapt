  "pipelines": [
    {
      "id": 1,
      "name": "Nuclei",
      "description": "1. Set image nucleus channel\n2. Adapt threshold. Recommanded autoTH: Triangle, Moments or Otsu\n3. Define min particle size in \"Classifier\" to filter out small aggregates not connected to Nuclei.",
      "imageSource": {
        "channel": 0
      },
      "enabled": true,
      "steps": [
        {
          "enabled": true,
          "command": {
            "type": "ROLLING_BALL",
            "radius": 4.0,
            "ballType": "PARABOLOID",
            "preSmooth": true
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "THRESHOLD",
            "thresholds": [
              {
                "method": {
                  "type": "TRIANGLE"
                },
                "minThreshold": 200.0,
                "maxThreshold": 65535.0,
                "unit": "BIT",
                "segmentationClass": 4
              }
            ]
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "CONNECTED_COMPONENTS"
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "WATERSHED",
            "maximumFinderTolerance": 0.5,
            "smoothingSigma": 0.0,
            "minObjectSize": 0
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "EXTRACT_OBJECTS",
            "maxObjectsBeforeFail": 100000
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "CLASSIFY_OBJECTS",
            "inputClasses": [
              {
                "GLOBAL": 4
              }
            ],
            "matchHandling": "REMOVE_ALL_CLASSES_IF_NOT_MATCH",
            "originSegmentation": [],
            "outputClass": "UNSET",
            "overlappingWith": "UNSET",
            "minIntersectionArea": 0.0,
            "sizeUnit": "PIXELS",
            "minArea": 1000.0,
            "maxArea": 2147483600.0,
            "minCircularity": 0.0,
            "maxCircularity": 1.0,
            "minSolidity": 0.0,
            "maxSolidity": 1.0,
            "minAspectRatio": 0.0,
            "maxAspectRatio": 2147483600.0,
            "minEccentricity": 0.0,
            "maxEccentricity": 1.0,
            "minFeret": 0.0,
            "maxFeret": 2147483600.0,
            "allowEdgeTouching": true
          }
        }
      ]
    },
    {
      "id": 2,
      "name": "Cell area",
      "description": "Detects the whole brightfield cell area.\n1. Define Brightfield image channel\n2. Adjust TH if needed\n3. Define min particle size in \"Classifier\" to filter out small aggregates.",
      "imageSource": {
        "channel": 1
      },
      "enabled": true,
      "steps": [
        {
          "enabled": true,
          "command": {
            "type": "EDGE_DETECTION_SOBEL",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "BLUR",
            "kernelSize": 3
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "THRESHOLD",
            "thresholds": [
              {
                "method": {
                  "type": "MIN_ERROR"
                },
                "minThreshold": 0.0,
                "maxThreshold": 65535.0,
                "unit": "BIT",
                "segmentationClass": 11
              }
            ]
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "CONNECTED_COMPONENTS"
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "EXTRACT_OBJECTS",
            "maxObjectsBeforeFail": 100000
          }
        },
        {
          "enabled": true,
          "command": {
            "type": "CLASSIFY_OBJECTS",
            "inputClasses": [
              {
                "GLOBAL": 11
              }
            ],
            "matchHandling": "REMOVE_ALL_CLASSES_IF_NOT_MATCH",
            "originSegmentation": [],
            "outputClass": "UNSET",
            "overlappingWith": "UNSET",
            "minIntersectionArea": 0.0,
            "sizeUnit": "PIXELS",
            "minArea": 2000.0,
            "maxArea": 2147483600.0,
            "minCircularity": 0.0,
            "maxCircularity": 1.0,
            "minSolidity": 0.0,
            "maxSolidity": 1.0,
            "minAspectRatio": 0.0,
            "maxAspectRatio": 2147483600.0,
            "minEccentricity": 0.0,
            "maxEccentricity": 1.0,
            "minFeret": 0.0,
            "maxFeret": 2147483600.0,
            "allowEdgeTouching": true
          }
        }
      ]
    },
    {
      "id": 3,
      "name": "Cells",
      "description": "Based on the detected nuclei a Voronoi algorithm is used to separete individual cells. The detected cell area is used to find the border of the cells\n1. Measure intensity per cell in your required channels (default Ch0,1 and 2 is measured)",
      "imageSource": "SCRATCHPAD",
      "enabled": true,
      "steps": [
        {
          "enabled": true,
          "command": {
            "type": "VORONOI",
            "centers": {
              "GLOBAL": 4
            },
            "centerFilterClasses": [],
            "mask": {
              "GLOBAL": 11
            },
            "maskFilterClasses": [],
            "outputClass": {
              "GLOBAL": 12
            },
            "unit": "PIXELS",
            "maxRadius": 0.0,
            "excludeAreasAtTheEdges": false,
            "excludeAreasWithNoCenter": true
          }
        }
      ]
    },
